    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://odoo.rni.vn/xmlrpc/2/common",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "text/xml"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "body": "=<?xml version=\"1.0\"?>\n<methodCall>\n  <methodName>authenticate</methodName>\n  <params>\n    <param><value><string>odoo_rni_new_vps</string></value></param>\n    <param><value><string>anhxuanflowers@gmail.com</string></value></param>\n    <param><value><string>cece586091385feee0cfbbf8fbd06f2d4d7ea42e</string></value></param>\n    <param><value><struct></struct></value></param>\n  </params>\n</methodCall>",
        "options": {}
      },
      "id": "a1b2c3d4-0003-4000-8000-000000000003",
      "name": "Authenticate Odoo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [-380, -120]
    },
    {
      "parameters": {
        "jsCode": "const xml = $input.first().json.data;\nconst match = xml.match(/<value><int>(\\d+)<\\/int><\\/value>/);\nconst uid = match ? parseInt(match[1]) : null;\nif (!uid) throw new Error('Odoo authenticate failed, uid not found. XML: ' + xml.slice(0,300));\nreturn [{ json: { uid } }];"
      },
      "id": "a1b2c3d4-0004-4000-8000-000000000004",
      "name": "Extract UID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-160, -120]
    },
    {
      "parameters": {
        "jsCode": "const b = $node['Webhook'].json.body;\nconst lessonTitle = b.lessonTitle || '';\nconst courseName  = b.courseName  || '';\nconst completed   = parseInt(b.completedCount) || 0;\nconst total       = parseInt(b.totalCount)     || 0;\nconst pct         = parseInt(b.progressPct)    || 0;\nconst date        = (b.timestamp || new Date().toISOString()).slice(0,10);\n\n// XML-escape helper\nfunction xmlEsc(s){ return (s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }\n\n// Dùng &lt;br/&gt; để XML hợp lệ — Odoo decode entity → <br/> → render HTML\nconst note = `[${date}] ✅ Hoàn thành: ${xmlEsc(lessonTitle)}&lt;br/&gt;📚 Khóa: ${xmlEsc(courseName)}&lt;br/&gt;📊 Tiến độ: ${completed}/${total} bài (${pct}%)`;\n\n// Email XML-escaped dùng cho search domain\nconst email = (b.email || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');\n\nreturn [{ json: { note, email } }];"
      },
      "id": "a1b2c3d4-0005-4000-8000-000000000005",
      "name": "Build Progress Note",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [60, -120]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://odoo.rni.vn/xmlrpc/2/object",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "text/xml"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "body": "=<?xml version=\"1.0\"?>\n<methodCall>\n  <methodName>execute_kw</methodName>\n  <params>\n    <param><value><string>odoo_rni_new_vps</string></value></param>\n    <param><value><int>{{ $node['Extract UID'].json.uid }}</int></value></param>\n    <param><value><string>cece586091385feee0cfbbf8fbd06f2d4d7ea42e</string></value></param>\n    <param><value><string>crm.lead</string></value></param>\n    <param><value><string>search</string></value></param>\n    <param>\n      <value><array><data>\n        <value><array><data>\n          <value><array><data>\n            <value><string>email_from</string></value>\n            <value><string>=</string></value>\n            <value><string>{{ $node['Build Progress Note'].json.email }}</string></value>\n          </data></array></value>\n        </data></array></value>\n      </data></array></value>\n    </param>\n    <param><value><struct>\n      <member><name>limit</name><value><int>1</int></value></member>\n      <member><name>order</name><value><string>create_date desc</string></value></member>\n    </struct></value></param>\n  </params>\n</methodCall>",
        "options": {}
      },
      "id": "a1b2c3d4-0006-4000-8000-000000000006",
      "name": "Search Lead by Email",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [280, -120]
    },
    {
      "parameters": {
        "jsCode": "const xml = $input.first().json.data;\n// Match first integer inside the search result array\nconst match = xml.match(/<value><int>(\\d+)<\\/int><\\/value>/);\nconst leadId = match ? parseInt(match[1]) : null;\nconst found = leadId !== null && leadId > 0;\nreturn [{ json: { leadId, found } }];"
      },
      "id": "a1b2c3d4-0007-4000-8000-000000000007",
      "name": "Extract Lead ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, -120]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.found }}",
              "operation": "equal",
              "value2": true
            }
          ]
        }
      },
      "id": "a1b2c3d4-0008-4000-8000-000000000008",
