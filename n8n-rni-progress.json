        "body": "=<?xml version=\"1.0\"?>\n<methodCall>\n  <methodName>execute_kw</methodName>\n  <params>\n    <param><value><string>odoo_rni_new_vps</string></value></param>\n    <param><value><int>{{ $node['Extract UID'].json.uid }}</int></value></param>\n    <param><value><string>cece586091385feee0cfbbf8fbd06f2d4d7ea42e</string></value></param>\n    <param><value><string>crm.lead</string></value></param>\n    <param><value><string>message_post</string></value></param>\n    <param>\n      <value><array><data>\n        <value><array><data>\n          <value><int>{{ $node['Extract Lead ID'].json.leadId }}</int></value>\n        </data></array></value>\n      </data></array></value>\n    </param>\n    <param>\n      <value><struct>\n        <member><name>body</name><value><string>{{ $node['Build Progress Note'].json.note }}</string></value></member>\n        <member><name>message_type</name><value><string>comment</string></value></member>\n        <member><name>subtype_xmlid</name><value><string>mail.mt_note</string></value></member>\n      </struct></value>\n    </param>\n  </params>\n</methodCall>",
        "options": {}
      },
